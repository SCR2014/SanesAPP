@page "/loans"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]

@using System
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Sanes.Application.Clients.DTOs
@using Sanes.Application.Investors.DTOs
@using Sanes.Application.Loans.DTOs
@using Sanes.Application.Tenants.DTOs
@using Sanes.Domain.Enums

@inject ILoansWebService LoansService

<PageTitle>Préstamos - Sanes</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">
            Préstamos
        </h1>

        <p class="text-muted mb-0">
            Administración, originación y seguimiento de préstamos.
        </p>
    </div>

    <div class="d-flex gap-2">
        <button type="button"
                class="btn btn-outline-secondary"
                disabled="@(_isLoading ||
                            _isSaving ||
                            _isCancelling)"
                @onclick="RefreshAsync">
            Actualizar
        </button>

        <button type="button"
                class="btn btn-primary"
                disabled="@(_isLoading ||
                            _isSaving ||
                            _isCancelling)"
                @onclick="ShowCreateForm">
            Nuevo préstamo
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        @_errorMessage

        <button type="button"
                class="btn-close"
                aria-label="Cerrar"
                @onclick="ClearError">
        </button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success alert-dismissible">
        @_successMessage

        <button type="button"
                class="btn-close"
                aria-label="Cerrar"
                @onclick="ClearSuccess">
        </button>
    </div>
}

@if (_isLoading)
{
    <div class="card shadow-sm">
        <div class="card-body text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span>
            Cargando préstamos...
        </div>
    </div>
}
else
{
    @* ========================================================= *@
    @* CONFIRMACIÓN DE CANCELACIÓN                               *@
    @* ========================================================= *@

    @if (_loanPendingCancellation is not null)
    {
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-header text-bg-danger">
                <strong>
                    Confirmar cancelación
                </strong>
            </div>

            <div class="card-body">
                <p>
                    Está a punto de cancelar el préstamo de:
                </p>

                <dl class="row mb-3">
                    <dt class="col-sm-3">
                        Cliente
                    </dt>
                    <dd class="col-sm-9">
                        @_loanPendingCancellation.ClientName
                    </dd>

                    <dt class="col-sm-3">
                        Inversionista
                    </dt>
                    <dd class="col-sm-9">
                        @_loanPendingCancellation.InvestorName
                    </dd>

                    <dt class="col-sm-3">
                        Capital
                    </dt>
                    <dd class="col-sm-9">
                        @FormatMoney(
                            _loanPendingCancellation.PrincipalAmount)
                    </dd>

                    <dt class="col-sm-3">
                        Total contractual
                    </dt>
                    <dd class="col-sm-9">
                        @FormatMoney(
                            _loanPendingCancellation.TotalAmount)
                    </dd>
                </dl>

                <div class="alert alert-warning">
                    El préstamo no será eliminado.
                    Permanecerá en el historial con estado
                    <strong>Cancelado</strong>.
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-danger"
                            disabled="@_isCancelling"
                            @onclick="ConfirmCancelAsync">

                        @if (_isCancelling)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Cancelando...</span>
                        }
                        else
                        {
                            <span>Confirmar cancelación</span>
                        }

                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@_isCancelling"
                            @onclick="CancelCancellationRequest">
                        No cancelar
                    </button>
                </div>
            </div>
        </div>
    }

    @* ========================================================= *@
    @* FORMULARIO CREAR / EDITAR                                *@
    @* ========================================================= *@

    @if (_showLoanForm)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>
                    @(_editingLoan is null
                        ? "Nuevo préstamo"
                        : "Editar préstamo")
                </strong>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        disabled="@_isSaving"
                        @onclick="CloseLoanForm">
                    Cerrar
                </button>
            </div>

            <div class="card-body">

                @if (_editingLoan is null &&
                     (_clients.Count == 0 ||
                      _investors.Count == 0))
                {
                    <div class="alert alert-warning">
                        Para crear un préstamo debe existir al menos
                        un cliente activo y un inversionista activo.
                    </div>
                }

                <EditForm Model="_form"
                          OnValidSubmit="SaveLoanAsync">

                    <DataAnnotationsValidator />

                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row g-3">

                        @if (_editingLoan is null)
                        {
                            <div class="col-md-6">
                                <label class="form-label">
                                    Cliente
                                </label>

                                <InputSelect TValue="Guid"
                                             class="form-select"
                                             @bind-Value="_form.ClientId">

                                    <option value="@Guid.Empty">
                                        Seleccione un cliente
                                    </option>

                                    @foreach (var client in _clients)
                                    {
                                        <option value="@client.Id">
                                            @GetClientName(client)
                                        </option>
                                    }

                                </InputSelect>

                                <ValidationMessage
                                    For="@(() => _form.ClientId)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Inversionista
                                </label>

                                <InputSelect TValue="Guid"
                                             class="form-select"
                                             @bind-Value="_form.InvestorId">

                                    <option value="@Guid.Empty">
                                        Seleccione un inversionista
                                    </option>

                                    @foreach (var investor in _investors)
                                    {
                                        <option value="@investor.Id">
                                            @investor.Name
                                        </option>
                                    }

                                </InputSelect>

                                <ValidationMessage
                                    For="@(() => _form.InvestorId)" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <label class="form-label">
                                    Cliente
                                </label>

                                <input class="form-control"
                                       value="@_editingLoan.ClientName"
                                       disabled />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Inversionista
                                </label>

                                <input class="form-control"
                                       value="@_editingLoan.InvestorName"
                                       disabled />
                            </div>

                            <div class="col-12">
                                <div class="alert alert-light border mb-0">
                                    El cliente y el inversionista pertenecen
                                    al contrato original y no se modifican
                                    desde esta edición.
                                </div>
                            </div>
                        }

                        <div class="col-md-4">
                            <label class="form-label">
                                Capital
                            </label>

                            <InputNumber class="form-control"
                                         @bind-Value="_form.PrincipalAmount" />

                            <ValidationMessage
                                For="@(() => _form.PrincipalAmount)" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Monto de cuota
                            </label>

                            <InputNumber class="form-control"
                                         @bind-Value="_form.InstallmentAmount" />

                            <ValidationMessage
                                For="@(() => _form.InstallmentAmount)" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Cantidad de cuotas
                            </label>

                            <InputNumber class="form-control"
                                         @bind-Value="_form.TotalInstallments" />

                            <ValidationMessage
                                For="@(() => _form.TotalInstallments)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Frecuencia
                            </label>

                            <InputSelect TValue="PaymentFrequency"
                                         class="form-select"
                                         @bind-Value="_form.PaymentFrequency">

                                @foreach (var frequency in
                                    Enum.GetValues<PaymentFrequency>())
                                {
                                    <option value="@frequency">
                                        @GetPaymentFrequencyLabel(
                                            frequency)
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage
                                For="@(() => _form.PaymentFrequency)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Fecha de inicio
                            </label>

                            <InputDate TValue="DateTime"
                                       class="form-control"
                                       @bind-Value="_form.StartDate" />

                            <ValidationMessage
                                For="@(() => _form.StartDate)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Notas
                            </label>

                            <InputTextArea class="form-control"
                                           rows="3"
                                           @bind-Value="_form.Notes" />

                            <ValidationMessage
                                For="@(() => _form.Notes)" />
                        </div>

                    </div>

                    @if (_editingLoan is null)
                    {
                        @* ================================================= *@
                        @* MORA - SOLO CREACIÓN                             *@
                        @* ================================================= *@

                        <hr class="my-4" />

                        <h5>
                            Política de mora
                        </h5>

                        <p class="text-muted small">
                            Por defecto se utilizará la política configurada
                            para el negocio. Puede personalizarse únicamente
                            para este préstamo.
                        </p>

                        <div class="form-check mb-3">
                            <InputCheckbox class="form-check-input"
                                           @bind-Value="_form.OverrideLateFeePolicy" />

                            <label class="form-check-label">
                                Personalizar política de mora
                            </label>
                        </div>

                        @if (!_form.OverrideLateFeePolicy)
                        {
                            <div class="alert alert-light border">

                                <div class="fw-semibold mb-2">
                                    Política predeterminada
                                </div>

                                <div>
                                    Estado:
                                    <strong>
                                        @(_form.LateFeeEnabled
                                            ? "Habilitada"
                                            : "Deshabilitada")
                                    </strong>
                                </div>

                                @if (_form.LateFeeEnabled)
                                {
                                    <div>
                                        Tipo:
                                        <strong>
                                            @GetLateFeeCalculationLabel(
                                                _form.LateFeeCalculationType)
                                        </strong>
                                    </div>

                                    <div>
                                        Monto:
                                        <strong>
                                            @FormatMoney(
                                                _form.LateFeeAmount)
                                        </strong>
                                    </div>

                                    <div>
                                        Días de gracia:
                                        <strong>
                                            @_form.LateFeeGraceDays
                                        </strong>
                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="row g-3">

                                <div class="col-md-4">
                                    <div class="form-check mt-md-4 pt-md-2">
                                        <InputCheckbox class="form-check-input"
                                                       @bind-Value="_form.LateFeeEnabled" />

                                        <label class="form-check-label">
                                            Habilitar mora
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Monto de mora
                                    </label>

                                    <InputNumber class="form-control"
                                                 @bind-Value="_form.LateFeeAmount" />

                                    <ValidationMessage
                                        For="@(() => _form.LateFeeAmount)" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Días de gracia
                                    </label>

                                    <InputNumber class="form-control"
                                                 @bind-Value="_form.LateFeeGraceDays" />

                                    <ValidationMessage
                                        For="@(() => _form.LateFeeGraceDays)" />
                                </div>

                                <div class="col-12">
                                    <div class="small text-muted">
                                        Tipo de cálculo:
                                        <strong>
                                            @GetLateFeeCalculationLabel(
                                                _form.LateFeeCalculationType)
                                        </strong>
                                    </div>
                                </div>

                            </div>
                        }

                        @* ================================================= *@
                        @* GARANTÍA - SOLO CREACIÓN                         *@
                        @* ================================================= *@

                        <hr class="my-4" />

                        <h5>
                            Garantía
                        </h5>

                        @if (_tenant?.GuaranteeRequiredFromAmount
                            is decimal guaranteeThreshold)
                        {
                            <div class="alert alert-info">
                                El negocio requiere garantía para préstamos
                                con capital igual o superior a
                                <strong>
                                    @FormatMoney(guaranteeThreshold)
                                </strong>.
                            </div>
                        }
                        else
                        {
                            <div class="text-muted mb-3">
                                No existe un monto mínimo configurado
                                para exigir garantía automáticamente.
                            </div>
                        }

                        @if (_form.RequiresGuarantee)
                        {
                            <div class="alert alert-warning">
                                El capital indicado requiere una garantía.
                            </div>
                        }
                        else
                        {
                            <div class="form-check mb-3">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="_form.IncludeGuarantee" />

                                <label class="form-check-label">
                                    Registrar garantía voluntariamente
                                </label>
                            </div>
                        }

                        @if (_form.RequiresGuarantee ||
                             _form.IncludeGuarantee)
                        {
                            <div class="row g-3">

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Tipo de garantía
                                    </label>

                                    <InputSelect TValue="LoanGuaranteeType?"
                                                 class="form-select"
                                                 @bind-Value="_form.GuaranteeType">

                                        <option value="">
                                            Seleccione
                                        </option>

                                        @foreach (var type in
                                            Enum.GetValues<LoanGuaranteeType>())
                                        {
                                            <option value="@type">
                                                @GetGuaranteeTypeLabel(type)
                                            </option>
                                        }

                                    </InputSelect>

                                    <ValidationMessage
                                        For="@(() => _form.GuaranteeType)" />
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label">
                                        Referencia de garantía
                                    </label>

                                    <InputText class="form-control"
                                               @bind-Value="_form.GuaranteeReference" />

                                    <ValidationMessage
                                        For="@(() => _form.GuaranteeReference)" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label">
                                        Descripción
                                    </label>

                                    <InputTextArea class="form-control"
                                                   rows="3"
                                                   @bind-Value="_form.GuaranteeDescription" />

                                    <ValidationMessage
                                        For="@(() => _form.GuaranteeDescription)" />
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        @* ================================================= *@
                        @* INFORMACIÓN CONGELADA EN EDICIÓN                 *@
                        @* ================================================= *@

                        <hr class="my-4" />

                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <div class="fw-semibold mb-2">
                                        Política de mora
                                    </div>

                                    @if (_editingLoan.LateFeeEnabled)
                                    {
                                        <div>
                                            @GetLateFeeCalculationLabel(
                                                _editingLoan.LateFeeCalculationType)
                                        </div>

                                        <div>
                                            Monto:
                                            <strong>
                                                @FormatMoney(
                                                    _editingLoan.LateFeeAmount)
                                            </strong>
                                        </div>

                                        <div>
                                            Días de gracia:
                                            <strong>
                                                @_editingLoan.LateFeeGraceDays
                                            </strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            Mora deshabilitada
                                        </div>
                                    }

                                    <div class="small text-muted mt-2">
                                        Esta política no se modifica
                                        mediante la edición básica del préstamo.
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <div class="fw-semibold mb-2">
                                        Garantía
                                    </div>

                                    @if (_editingLoan.Guarantee is not null)
                                    {
                                        <div>
                                            <strong>
                                                @GetGuaranteeTypeLabel(
                                                    _editingLoan.Guarantee.Type)
                                            </strong>
                                        </div>

                                        <div>
                                            @_editingLoan.Guarantee.Reference
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            _editingLoan.Guarantee.Description))
                                        {
                                            <div class="small text-muted mt-2">
                                                @_editingLoan.Guarantee.Description
                                            </div>
                                        }
                                    }
                                    else if (_editingLoan.GuaranteeRequired)
                                    {
                                        <div class="text-warning">
                                            El préstamo tiene política de
                                            garantía requerida, pero no existe
                                            una garantía asociada.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            Sin garantía registrada
                                        </div>
                                    }

                                    <div class="small text-muted mt-2">
                                        La garantía no se modifica mediante
                                        esta edición básica.
                                    </div>
                                </div>
                            </div>

                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@(
                                    _isSaving ||
                                    (_editingLoan is null &&
                                     (_clients.Count == 0 ||
                                      _investors.Count == 0)))">

                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>

                                <span>
                                    Guardando...
                                </span>
                            }
                            else if (_editingLoan is null)
                            {
                                <span>
                                    Crear préstamo
                                </span>
                            }
                            else
                            {
                                <span>
                                    Guardar cambios
                                </span>
                            }

                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@_isSaving"
                                @onclick="CloseLoanForm">
                            Cancelar
                        </button>

                    </div>

                </EditForm>

            </div>
        </div>
    }

    @* ========================================================= *@
    @* DETALLE FINANCIERO                                       *@
    @* ========================================================= *@

    @if (_isLoadingDetail)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body text-muted">
                <span class="spinner-border spinner-border-sm me-2"></span>
                Cargando detalle del préstamo...
            </div>
        </div>
    }
    else if (_selectedLoan is not null &&
             _selectedSummary is not null)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">

                <div>
                    <strong>
                        Detalle del préstamo
                    </strong>

                    <span class="@GetStatusBadgeClass(_selectedLoan.Status) ms-2">
                        @GetStatusLabel(_selectedLoan.Status)
                    </span>
                </div>

                <div class="d-flex gap-2">

                    @if (_selectedLoan.Status ==
                         LoanStatus.Active)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                disabled="@(_isSaving ||
                                            _isCancelling)"
                                @onclick="() => StartEditAsync(_selectedLoan.Id)">
                            Editar
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                disabled="@(_isSaving ||
                                            _isCancelling)"
                                @onclick="() => RequestCancel(_selectedLoan)">
                            Cancelar
                        </button>
                    }

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="CloseLoanDetail">
                        Cerrar
                    </button>

                </div>
            </div>

            <div class="card-body">

                <div class="row g-3 mb-4">

                    <div class="col-md-6">
                        <div class="text-muted small">
                            Cliente
                        </div>

                        <div class="fw-semibold">
                            @_selectedLoan.ClientName
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">
                            Inversionista
                        </div>

                        <div class="fw-semibold">
                            @_selectedLoan.InvestorName
                        </div>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">
                                Capital
                            </div>

                            <div class="fs-5 fw-semibold">
                                @FormatMoney(
                                    _selectedSummary.PrincipalAmount)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">
                                Total contractual
                            </div>

                            <div class="fs-5 fw-semibold">
                                @FormatMoney(
                                    _selectedSummary.TotalAmount)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">
                                Interés contractual
                            </div>

                            <div class="fs-5 fw-semibold">
                                @FormatMoney(
                                    _selectedSummary.InterestAmount)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">
                                Pagado
                            </div>

                            <div class="fs-5 fw-semibold">
                                @FormatMoney(
                                    _selectedSummary.AmountPaid)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">
                                Balance contractual
                            </div>

                            <div class="fs-5 fw-semibold">
                                @FormatMoney(
                                    _selectedSummary.Balance)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">
                                Mora pendiente
                            </div>

                            <div class="fs-5 fw-semibold">
                                @FormatMoney(
                                    _selectedSummary.LateFeeBalance)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">
                                Total pendiente
                            </div>

                            <div class="fs-5 fw-bold">
                                @FormatMoney(
                                    _selectedSummary.TotalOutstanding)
                            </div>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="row g-3">

                    <div class="col-md-3">
                        <div class="text-muted small">
                            Cuota
                        </div>

                        <div>
                            @FormatMoney(
                                _selectedSummary.InstallmentAmount)
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted small">
                            Cuotas completadas
                        </div>

                        <div>
                            @_selectedSummary.CompletedInstallments
                            /
                            @_selectedSummary.TotalInstallments
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted small">
                            Cuotas restantes
                        </div>

                        <div>
                            @_selectedSummary.RemainingInstallments
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted small">
                            Porcentaje pagado
                        </div>

                        <div>
                            @($"{_selectedSummary.PercentagePaid:N2} %")
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Pagado de cuota actual
                        </div>

                        <div>
                            @FormatMoney(
                                _selectedSummary.CurrentInstallmentPaidAmount)
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Restante de cuota actual
                        </div>

                        <div>
                            @FormatMoney(
                                _selectedSummary.CurrentInstallmentRemainingAmount)
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Próxima cuota requerida
                        </div>

                        <div>
                            @FormatMoney(
                                _selectedSummary.NextInstallmentAmountDue)
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Frecuencia
                        </div>

                        <div>
                            @GetPaymentFrequencyLabel(
                                _selectedSummary.PaymentFrequency)
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Fecha de inicio
                        </div>

                        <div>
                            @FormatDate(_selectedSummary.StartDate)
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Próximo pago
                        </div>

                        <div>
                            @FormatDate(_selectedSummary.NextPaymentDate)
                        </div>
                    </div>

                </div>

                @if (_selectedSummary.IsOverdue ||
                     _selectedSummary.HasOutstandingLateFees)
                {
                    <hr class="my-4" />

                    <div class="alert alert-warning mb-0">

                        <div class="fw-semibold mb-2">
                            Información de atraso
                        </div>

                        @if (_selectedSummary.IsOverdue)
                        {
                            <div>
                                Días de atraso:
                                <strong>
                                    @_selectedSummary.DaysOverdue
                                </strong>
                            </div>

                            <div>
                                Cuotas vencidas:
                                <strong>
                                    @_selectedSummary.OverdueInstallments
                                </strong>
                            </div>

                            <div>
                                Monto contractual vencido:
                                <strong>
                                    @FormatMoney(
                                        _selectedSummary.OverdueAmount)
                                </strong>
                            </div>
                        }

                        @if (_selectedSummary.HasOutstandingLateFees)
                        {
                            <div>
                                Mora pendiente:
                                <strong>
                                    @FormatMoney(
                                        _selectedSummary.LateFeeBalance)
                                </strong>
                            </div>
                        }

                        <div>
                            Total vencido incluyendo mora:
                            <strong>
                                @FormatMoney(
                                    _selectedSummary.TotalOverdueAmountDue)
                            </strong>
                        </div>

                    </div>
                }

                <hr class="my-4" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="fw-semibold mb-2">
                                Política de mora
                            </div>

                            @if (_selectedLoan.LateFeeEnabled)
                            {
                                <div>
                                    @GetLateFeeCalculationLabel(
                                        _selectedLoan.LateFeeCalculationType)
                                </div>

                                <div>
                                    Monto:
                                    <strong>
                                        @FormatMoney(
                                            _selectedLoan.LateFeeAmount)
                                    </strong>
                                </div>

                                <div>
                                    Días de gracia:
                                    <strong>
                                        @_selectedLoan.LateFeeGraceDays
                                    </strong>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    Mora deshabilitada
                                </div>
                            }

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="fw-semibold mb-2">
                                Garantía
                            </div>

                            @if (_selectedLoan.Guarantee is not null)
                            {
                                <div>
                                    <strong>
                                        @GetGuaranteeTypeLabel(
                                            _selectedLoan.Guarantee.Type)
                                    </strong>
                                </div>

                                <div>
                                    @_selectedLoan.Guarantee.Reference
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    _selectedLoan.Guarantee.Description))
                                {
                                    <div class="small text-muted mt-2">
                                        @_selectedLoan.Guarantee.Description
                                    </div>
                                }
                            }
                            else if (_selectedLoan.GuaranteeRequired)
                            {
                                <div class="text-warning">
                                    Garantía requerida, pero no registrada.
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    Sin garantía registrada
                                </div>
                            }

                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        _selectedLoan.Notes))
                    {
                        <div class="col-12">
                            <div class="border rounded p-3">
                                <div class="fw-semibold mb-2">
                                    Notas
                                </div>

                                <div>
                                    @_selectedLoan.Notes
                                </div>
                            </div>
                        </div>
                    }

                </div>

            </div>
        </div>
    }

    @* ========================================================= *@
    @* BUSCADOR Y FILTROS                                       *@
    @* ========================================================= *@

    <div class="card shadow-sm mb-3">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-lg-5">
                    <label class="form-label">
                        Buscar
                    </label>

                    <input class="form-control"
                           placeholder="Cliente o inversionista..."
                           @bind="_searchText"
                           @bind:event="oninput" />
                </div>

                <div class="col-lg-7">
                    <label class="form-label d-block">
                        Estado
                    </label>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="button"
                                class="@GetFilterButtonClass(null)"
                                @onclick="() => SetStatusFilter(null)">
                            Todos
                            <span class="badge text-bg-light ms-1">
                                @_loans.Count
                            </span>
                        </button>

                        <button type="button"
                                class="@GetFilterButtonClass(LoanStatus.Active)"
                                @onclick="() => SetStatusFilter(LoanStatus.Active)">
                            Activos
                            <span class="badge text-bg-light ms-1">
                                @_loans.Count(
                                    x => x.Status == LoanStatus.Active)
                            </span>
                        </button>

                        <button type="button"
                                class="@GetFilterButtonClass(LoanStatus.Paid)"
                                @onclick="() => SetStatusFilter(LoanStatus.Paid)">
                            Pagados
                            <span class="badge text-bg-light ms-1">
                                @_loans.Count(
                                    x => x.Status == LoanStatus.Paid)
                            </span>
                        </button>

                        <button type="button"
                                class="@GetFilterButtonClass(LoanStatus.Cancelled)"
                                @onclick="() => SetStatusFilter(LoanStatus.Cancelled)">
                            Cancelados
                            <span class="badge text-bg-light ms-1">
                                @_loans.Count(
                                    x => x.Status == LoanStatus.Cancelled)
                            </span>
                        </button>

                    </div>
                </div>

            </div>

            <div class="small text-muted mt-3">
                Mostrando
                <strong>@FilteredLoans.Count()</strong>
                de
                <strong>@_loans.Count</strong>
                préstamos.
            </div>

        </div>
    </div>

    @* ========================================================= *@
    @* TABLA DE PRÉSTAMOS                                       *@
    @* ========================================================= *@

    @if (!FilteredLoans.Any())
    {
        <div class="alert alert-light border">
            No hay préstamos que coincidan con los filtros.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Inversionista</th>
                            <th>Capital</th>
                            <th>Total contractual</th>
                            <th>Cuota</th>
                            <th>Frecuencia</th>
                            <th>Próximo pago</th>
                            <th>Estado</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var loan in FilteredLoans)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @loan.ClientName
                                    </strong>
                                </td>

                                <td>
                                    @loan.InvestorName
                                </td>

                                <td>
                                    @FormatMoney(
                                        loan.PrincipalAmount)
                                </td>

                                <td>
                                    @FormatMoney(
                                        loan.TotalAmount)
                                </td>

                                <td>
                                    @FormatMoney(
                                        loan.InstallmentAmount)
                                </td>

                                <td>
                                    @GetPaymentFrequencyLabel(
                                        loan.PaymentFrequency)
                                </td>

                                <td>
                                    @FormatDate(loan.NextPaymentDate)
                                </td>

                                <td>
                                    <span class="@GetStatusBadgeClass(loan.Status)">
                                        @GetStatusLabel(loan.Status)
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-1">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@IsBusy"
                                                @onclick="() => ViewLoanAsync(loan.Id)">
                                            Ver
                                        </button>

                                        @if (loan.Status ==
                                             LoanStatus.Active)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    disabled="@IsBusy"
                                                    @onclick="() => StartEditAsync(loan.Id)">
                                                Editar
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    disabled="@IsBusy"
                                                    @onclick="() => RequestCancel(loan)">
                                                Cancelar
                                            </button>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }
}

@code
{
    private List<LoanResponse> _loans = [];

    private List<ClientResponse> _clients = [];

    private List<InvestorResponse> _investors = [];

    private TenantDto? _tenant;

    private LoanFormModel _form =
        new();

    private LoanResponse? _editingLoan;

    private LoanResponse? _selectedLoan;

    private LoanFinancialSummaryResponse?
        _selectedSummary;

    private LoanResponse?
        _loanPendingCancellation;

    private LoanStatus? _statusFilter;

    private string _searchText =
        string.Empty;

    private bool _isLoading =
        true;

    private bool _isSaving;

    private bool _isLoadingDetail;

    private bool _isCancelling;

    private bool _showLoanForm;

    private string? _errorMessage;

    private string? _successMessage;

    private bool IsBusy =>
        _isLoading ||
        _isSaving ||
        _isLoadingDetail ||
        _isCancelling;

    private IEnumerable<LoanResponse>
        FilteredLoans
    {
        get
        {
            var query =
                _loans.AsEnumerable();

            if (_statusFilter.HasValue)
            {
                query =
                    query.Where(
                        x => x.Status ==
                             _statusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(
                _searchText))
            {
                var search =
                    _searchText.Trim();

                query =
                    query.Where(
                        x =>
                            x.ClientName.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase) ||
                            x.InvestorName.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    protected override async Task
        OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _tenant =
                await LoansService
                    .GetTenantAsync();

            _clients =
                await LoansService
                    .GetClientsAsync();

            _investors =
                await LoansService
                    .GetInvestorsAsync();

            _loans =
                await LoansService
                    .GetAllAsync();

            _form =
                LoanFormModel.ForCreate(
                    _tenant);
        }
        catch (Exception ex)
        {
            _errorMessage =
                "No fue posible cargar los préstamos. " +
                ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        CloseLoanForm();
        CloseLoanDetail();

        _loanPendingCancellation =
            null;

        _successMessage =
            null;

        await LoadAsync();
    }

    private void ShowCreateForm()
    {
        _errorMessage =
            null;

        _successMessage =
            null;

        _loanPendingCancellation =
            null;

        CloseLoanDetail();

        _editingLoan =
            null;

        if (_tenant is null)
        {
            _errorMessage =
                "No fue posible cargar la configuración del negocio.";

            return;
        }

        _form =
            LoanFormModel.ForCreate(
                _tenant);

        _showLoanForm =
            true;
    }

    private async Task StartEditAsync(
        Guid loanId)
    {
        _errorMessage =
            null;

        _successMessage =
            null;

        _loanPendingCancellation =
            null;

        try
        {
            var loan =
                await LoansService
                    .GetByIdAsync(
                        loanId);

            if (loan is null)
            {
                _errorMessage =
                    "El préstamo solicitado no fue encontrado.";

                return;
            }

            if (loan.Status !=
                LoanStatus.Active)
            {
                _errorMessage =
                    "Solo los préstamos activos pueden editarse.";

                return;
            }

            CloseLoanDetail();

            _editingLoan =
                loan;

            _form =
                LoanFormModel.FromResponse(
                    loan);

            _showLoanForm =
                true;
        }
        catch (Exception ex)
        {
            _errorMessage =
                "No fue posible cargar el préstamo para edición. " +
                ex.Message;
        }
    }

    private void CloseLoanForm()
    {
        _showLoanForm =
            false;

        _editingLoan =
            null;

        if (_tenant is not null)
        {
            _form =
                LoanFormModel.ForCreate(
                    _tenant);
        }
    }

    private async Task SaveLoanAsync()
    {
        _isSaving =
            true;

        _errorMessage =
            null;

        _successMessage =
            null;

        try
        {
            if (_editingLoan is null)
            {
                var created =
                    await LoansService
                        .CreateAsync(
                            _form.ToCreateRequest());

                _successMessage =
                    $"Préstamo de {created.ClientName} " +
                    "creado correctamente.";
            }
            else
            {
                var updated =
                    await LoansService
                        .UpdateAsync(
                            _editingLoan.Id,
                            _form.ToUpdateRequest());

                if (updated is null)
                {
                    _errorMessage =
                        "El préstamo solicitado no fue encontrado.";

                    return;
                }

                _successMessage =
                    $"Préstamo de {updated.ClientName} " +
                    "actualizado correctamente.";
            }

            _loans =
                await LoansService
                    .GetAllAsync();

            CloseLoanForm();
            CloseLoanDetail();
        }
        catch (ArgumentException ex)
        {
            _errorMessage =
                ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage =
                "No fue posible guardar el préstamo. " +
                ex.Message;
        }
        finally
        {
            _isSaving =
                false;
        }
    }

    private async Task ViewLoanAsync(
        Guid loanId)
    {
        _isLoadingDetail =
            true;

        _errorMessage =
            null;

        _successMessage =
            null;

        _loanPendingCancellation =
            null;

        CloseLoanForm();

        try
        {
            var loan =
                await LoansService
                    .GetByIdAsync(
                        loanId);

            if (loan is null)
            {
                _selectedLoan =
                    null;

                _selectedSummary =
                    null;

                _errorMessage =
                    "El préstamo solicitado no fue encontrado.";

                return;
            }

            var summary =
                await LoansService
                    .GetFinancialSummaryAsync(
                        loanId);

            if (summary is null)
            {
                _selectedLoan =
                    null;

                _selectedSummary =
                    null;

                _errorMessage =
                    "No fue posible obtener el resumen financiero.";

                return;
            }

            _selectedLoan =
                loan;

            _selectedSummary =
                summary;
        }
        catch (Exception ex)
        {
            _selectedLoan =
                null;

            _selectedSummary =
                null;

            _errorMessage =
                "No fue posible cargar el detalle del préstamo. " +
                ex.Message;
        }
        finally
        {
            _isLoadingDetail =
                false;
        }
    }

    private void CloseLoanDetail()
    {
        _selectedLoan =
            null;

        _selectedSummary =
            null;
    }

    private void RequestCancel(
        LoanResponse loan)
    {
        _errorMessage =
            null;

        _successMessage =
            null;

        if (loan.Status !=
            LoanStatus.Active)
        {
            _errorMessage =
                "Solo los préstamos activos pueden cancelarse.";

            return;
        }

        CloseLoanForm();

        _loanPendingCancellation =
            loan;
    }

    private async Task ConfirmCancelAsync()
    {
        if (_loanPendingCancellation is null)
        {
            return;
        }

        _isCancelling =
            true;

        _errorMessage =
            null;

        _successMessage =
            null;

        var loanId =
            _loanPendingCancellation.Id;

        var clientName =
            _loanPendingCancellation.ClientName;

        try
        {
            var cancelled =
                await LoansService
                    .CancelAsync(
                        loanId);

            if (!cancelled)
            {
                _errorMessage =
                    "El préstamo solicitado no fue encontrado.";

                return;
            }

            _loans =
                await LoansService
                    .GetAllAsync();

            if (_selectedLoan?.Id ==
                loanId)
            {
                CloseLoanDetail();
            }

            _loanPendingCancellation =
                null;

            _successMessage =
                $"Préstamo de {clientName} " +
                "cancelado correctamente.";
        }
        catch (ArgumentException ex)
        {
            _errorMessage =
                ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage =
                "No fue posible cancelar el préstamo. " +
                ex.Message;
        }
        finally
        {
            _isCancelling =
                false;
        }
    }

    private void CancelCancellationRequest()
    {
        _loanPendingCancellation =
            null;
    }

    private void SetStatusFilter(
        LoanStatus? status)
    {
        _statusFilter =
            status;
    }

    private string GetFilterButtonClass(
        LoanStatus? status)
    {
        return _statusFilter == status
            ? "btn btn-primary"
            : "btn btn-outline-primary";
    }

    private string FormatMoney(
        decimal amount)
    {
        var symbol =
            _tenant?.CurrencySymbol;

        if (string.IsNullOrWhiteSpace(
            symbol))
        {
            symbol =
                _tenant?.CurrencyCode
                ?? string.Empty;
        }

        return string.IsNullOrWhiteSpace(
            symbol)
            ? amount.ToString("N2")
            : $"{symbol} {amount:N2}";
    }

    private static string GetClientName(
        ClientResponse client)
    {
        return string.Join(
            " ",
            new[]
            {
                client.FirstName,
                client.LastName
            }
            .Where(
                x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string
        GetPaymentFrequencyLabel(
            PaymentFrequency frequency)
    {
        return frequency switch
        {
            PaymentFrequency.Daily =>
                "Diaria",

            PaymentFrequency.Weekly =>
                "Semanal",

            PaymentFrequency.Biweekly =>
                "Quincenal",

            PaymentFrequency.Monthly =>
                "Mensual",

            _ =>
                frequency.ToString()
        };
    }

    private static string
        GetStatusLabel(
            LoanStatus status)
    {
        return status switch
        {
            LoanStatus.Active =>
                "Activo",

            LoanStatus.Paid =>
                "Pagado",

            LoanStatus.Cancelled =>
                "Cancelado",

            _ =>
                status.ToString()
        };
    }

    private static string
        GetStatusBadgeClass(
            LoanStatus status)
    {
        return status switch
        {
            LoanStatus.Active =>
                "badge text-bg-success",

            LoanStatus.Paid =>
                "badge text-bg-primary",

            LoanStatus.Cancelled =>
                "badge text-bg-secondary",

            _ =>
                "badge text-bg-light"
        };
    }

    private static string
        GetLateFeeCalculationLabel(
            LateFeeCalculationType type)
    {
        return type switch
        {
            LateFeeCalculationType.FixedAmountPerInstallment =>
                "Monto fijo por cuota vencida",

            _ =>
                type.ToString()
        };
    }

    private static string FormatDate(
        DateTime value)
    {
        return value.ToString(
            "dd/MM/yyyy");
    }

    private static string
        GetGuaranteeTypeLabel(
            LoanGuaranteeType type)
    {
        return type switch
        {
            LoanGuaranteeType.IdentificationDocument =>
                "Documento de identificación",

            LoanGuaranteeType.Guarantor =>
                "Garante",

            LoanGuaranteeType.Collateral =>
                "Bien en garantía",

            LoanGuaranteeType.Other =>
                "Otro",

            _ =>
                type.ToString()
        };
    }

    private void ClearError()
    {
        _errorMessage =
            null;
    }

    private void ClearSuccess()
    {
        _successMessage =
            null;
    }
}
