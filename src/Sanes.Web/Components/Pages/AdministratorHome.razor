@page "/admin"

@attribute [Authorize(Roles = WebRoles.Administrator)]

<PageTitle>Administración - Sanes</PageTitle>

<h1>Administración</h1>

<p class="lead">
    Gestión operativa de SanesApp.
</p>

<div class="row g-3 mt-2">

    <div class="col-12 col-md-6 col-xl-4">

        <div class="card h-100">

            <div class="card-body">

                <h2 class="h5">
                    Inversionistas
                </h2>

                <p class="text-muted">
                    Crear, editar, desactivar
                    y reactivar inversionistas.
                </p>

                <a class="btn btn-primary"
                   href="/admin/investors">

                    Administrar inversionistas

                </a>

            </div>

        </div>

    </div>

</div>