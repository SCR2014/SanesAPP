        }
    }

    private void RequestDelete(
        AppUserResponse user)
    {
        ClearMessage();
        CloseAllPanels();

        _pendingDeleteUser =
            user;
    }

    private void CancelDelete()
    {
        _pendingDeleteUser =
            null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDeleteUser is null)
        {
            return;
        }

        ClearMessage();

        _isSaving =
            true;

        try
        {
            var deleted =
                await AppUsersService
                    .DeleteAsync(
                        _pendingDeleteUser.Id);

            if (!deleted)
            {
                SetError(
                    "El usuario no fue encontrado.");

                return;
            }

            _pendingDeleteUser =
                null;

            SetSuccess(
                "Usuario desactivado correctamente.");

            await ReloadUsersAsync();
        }
        catch (InvalidOperationException ex)
        {
            SetError(
                ex.Message);
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible desactivar el usuario.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al desactivar el usuario.");
        }
        finally
        {
            _isSaving =
                false;
        }
    }

