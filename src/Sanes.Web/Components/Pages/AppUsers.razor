    private void OpenPassword(
        AppUserResponse user)
    {
        ClearMessage();
        CloseAllPanels();

        _passwordUser =
            user;

        _passwordForm =
            new AppUserPasswordFormModel();
    }

    private void ClosePassword()
    {
        _passwordUser =
            null;

        _passwordForm =
            new AppUserPasswordFormModel();
    }

    private async Task SavePasswordAsync()
    {
        if (_passwordUser is null)
        {
            return;
        }

        ClearMessage();

        _isSaving =
            true;

        try
        {
            var updated =
                await AppUsersService
                    .SetPasswordAsync(
                        _passwordUser.Id,
                        _passwordForm.Password);

            if (!updated)
            {
                SetError(
                    "El usuario no fue encontrado.");

                return;
            }

            ClosePassword();

            SetSuccess(
                "Contraseña actualizada correctamente.");
        }
        catch (ArgumentException ex)
        {
            SetError(
                ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            SetError(
                ex.Message);
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible cambiar la contraseña.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al cambiar la contraseña.");
        }
        finally
        {
            _isSaving =
                false;
        }
    }

    private async Task OpenRoutesAsync(
        AppUserResponse user)
    {
        if (!user.IsActive ||
            user.Role !=
                AppUserRole.Collector)
        {
            return;
        }

        ClearMessage();
        CloseAllPanels();

        _selectedCollector =
            user;

        _routeToAssignId =
            null;

        await ReloadAssignedRoutesAsync();
    }

    private async Task ReloadAssignedRoutesAsync()
    {
        if (_selectedCollector is null)
        {
            return;
        }

        _isLoadingRoutes =
            true;

        try
        {
            var assignments =
                await AppUsersService
                    .GetCollectionRoutesAsync(
                        _selectedCollector.Id);

            if (assignments is null)
            {
                SetError(
                    "El cobrador no fue encontrado.");

                CloseRoutes();

                return;
            }

            _assignedRoutes =
                assignments;
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible cargar las rutas del cobrador.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error al cargar las rutas del cobrador.");
        }
        finally
        {
            _isLoadingRoutes =
                false;
        }
    }

    private async Task AssignRouteAsync()
    {
        if (_selectedCollector is null ||
            !_routeToAssignId.HasValue)
        {
            return;
        }

        ClearMessage();

        _isSaving =
            true;

        try
        {
            var assigned =
                await AppUsersService
                    .AssignCollectionRouteAsync(
                        _selectedCollector.Id,
                        _routeToAssignId.Value);

            if (!assigned)
            {
                SetError(
                    "El cobrador o la ruta no fueron encontrados.");

                return;
            }

            _routeToAssignId =
                null;

            await ReloadAssignedRoutesAsync();

            SetSuccess(
                "Ruta asignada correctamente.");
        }
        catch (ArgumentException ex)
        {
            SetError(
                ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            SetError(
                ex.Message);
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible asignar la ruta.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al asignar la ruta.");
        }
        finally
        {
            _isSaving =
                false;
        }
    }

    private async Task UnassignRouteAsync(
        AppUserCollectionRouteResponse assignment)
    {
        if (_selectedCollector is null)
        {
            return;
        }

        ClearMessage();

        _isSaving =
            true;

        try
        {
            var removed =
                await AppUsersService
                    .UnassignCollectionRouteAsync(
                        _selectedCollector.Id,
                        assignment.CollectionRouteId);

            if (!removed)
            {
                SetError(
                    "La asignación de ruta no fue encontrada.");

                return;
            }

            await ReloadAssignedRoutesAsync();

            SetSuccess(
                "Ruta desasignada correctamente.");
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible desasignar la ruta.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al desasignar la ruta.");
        }
        finally
        {
            _isSaving =
                false;
        }
    }

    private void CloseRoutes()
    {
        _selectedCollector =
            null;

        _assignedRoutes =
            [];

        _routeToAssignId =
            null;

        _isLoadingRoutes =
            false;
    }

    private void CloseAllPanels()
    {
        _showUserForm =
            false;

        _editingUser =
            null;

        _passwordUser =
            null;

        _pendingDeleteUser =
            null;

        _selectedCollector =
            null;

        _assignedRoutes =
            [];

        _routeToAssignId =
            null;

        _passwordForm =
            new AppUserPasswordFormModel();

        _newUserPassword =
            string.Empty;

        _newUserConfirmPassword =
            string.Empty;
    }

    private static bool Contains(
        string? value,
        string search)
    {
        return !string.IsNullOrWhiteSpace(
                   value) &&
               value.Contains(
                   search,
                   StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(
            value)
            ? "—"
            : value;
    }

    private static string FormatDateTime(
        DateTime value)
    {
        return value
            .ToLocalTime()
            .ToString(
                "dd/MM/yyyy HH:mm");
    }

    private void SetSuccess(
        string message)
    {
        _pageMessage =
            message;

        _pageMessageIsError =
            false;
    }

    private void SetError(
        string message)
    {
        _pageMessage =
            message;

        _pageMessageIsError =
            true;
    }

    private void ClearMessage()
    {
        _pageMessage =
            null;
    }
}