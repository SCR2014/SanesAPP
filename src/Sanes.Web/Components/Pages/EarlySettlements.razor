@page "/early-settlements"

@attribute [Authorize(
    Roles = WebRoles.Administrator)]

@rendermode InteractiveServer

@using Sanes.Application.Loans.DTOs
@using Sanes.Application.Payments.DTOs
@using Sanes.Application.Tenants.DTOs
@using Sanes.Domain.Enums
@using Sanes.Web.EarlySettlements
@using Sanes.Web.Loans
@using Sanes.Web.PaymentReceipts

@inject ILoansWebService LoansService
@inject IEarlySettlementsWebService EarlySettlementsService
@inject IPaymentReceiptsWebService ReceiptsService

<PageTitle>Liquidación anticipada - Sanes</PageTitle>

<div class="d-flex flex-wrap
            justify-content-between
            align-items-start
            gap-3
            mb-4">

    <div>
        <h1 class="mb-1">
            Liquidación anticipada
        </h1>

        <p class="text-muted mb-0">
            Cotización y cierre anticipado
            de préstamos activos.
        </p>
    </div>

    <button type="button"
            class="btn btn-outline-secondary"
            disabled="@_isLoading"
            @onclick="ReloadAsync">

        <span class="bi bi-arrow-clockwise me-1"
              aria-hidden="true">
        </span>

        Actualizar

    </button>

</div>

@if (!string.IsNullOrWhiteSpace(
    _pageMessage))
{
    <div class="alert alert-danger">
        @_pageMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(
    _warningMessage))
{
    <div class="alert alert-warning">
        @_warningMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(
    _successMessage))
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

@if (_selectedReceipt is not null)
{
    <FieldCollectionReceiptCard
        Heading="Recibo de liquidación anticipada"
        Receipt="_selectedReceipt"
        Closed="CloseReceiptAsync" />
}

<div class="card mb-4">

    <div class="card-header">
        <strong>
            Buscar préstamo
        </strong>
    </div>

    <div class="card-body">

        <div class="row g-3 align-items-end">

            <div class="col-12 col-lg-7">

                <label class="form-label">
                    Cliente o inversionista
                </label>

                <input type="text"
                       class="form-control"
                       maxlength="150"
                       placeholder="Buscar por cliente o inversionista"
                       @bind="_search"
                       @bind:event="oninput" />

            </div>

            <div class="col-12 col-lg-3">

                <label class="form-label">
                    Estado
                </label>

                <select class="form-select"
                        @bind="_statusFilter">

                    <option value="active">
                        Activos
                    </option>

                    <option value="paid">
                        Pagados
                    </option>

                    <option value="cancelled">
                        Cancelados
                    </option>

                    <option value="all">
                        Todos
                    </option>

                </select>

            </div>

            <div class="col-12 col-lg-2">

                <button type="button"
                        class="btn btn-outline-secondary w-100"
                        @onclick="ClearFilters">

                    Limpiar

                </button>

            </div>

        </div>

    </div>

</div>

@if (_isLoading)
{
    <div class="text-center py-5">

        <div class="spinner-border"
             role="status">
        </div>

        <div class="text-muted mt-2">
            Cargando préstamos...
        </div>

    </div>
}
else if (!_loans.Any())
{
    <div class="alert alert-info">
        No hay préstamos disponibles.
    </div>
}
else
{
    <div class="card mb-4">

        <div class="card-header d-flex
                    justify-content-between
                    align-items-center">

            <strong>
                Préstamos
            </strong>

            <span class="badge text-bg-secondary">
                @FilteredLoans.Count()
            </span>

        </div>

        <div class="table-responsive">

            <table class="table table-hover
                          align-middle mb-0">

                <thead>
                    <tr>
                        <th>
                            Cliente
                        </th>

                        <th>
                            Inversionista
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end">
                            Monto total
                        </th>

                        <th>
                            Próximo pago
                        </th>

                        <th class="text-end">
                            Acción
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var loan
                        in FilteredLoans)
                    {
                        <tr class="@SelectedRowClass(
                            loan.Id)">

                            <td>
                                <strong>
                                    @loan.ClientName
                                </strong>
                            </td>

                            <td>
                                @loan.InvestorName
                            </td>

                            <td>
                                <span class="@StatusBadgeClass(
                                    loan.Status)">

                                    @StatusText(
                                        loan.Status)

                                </span>
                            </td>

                            <td class="text-end">
                                @Money(
                                    loan.TotalAmount)
                            </td>

                            <td>
                                @FormatDate(
                                    loan.NextPaymentDate)
                            </td>

                            <td class="text-end">

                                <button type="button"
                                        class="btn btn-sm
                                               btn-outline-primary"
                                        disabled="@_isLoanLoading"
                                        @onclick="() =>
                                            SelectLoanAsync(
                                                loan.Id)">

                                    Seleccionar

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @if (!FilteredLoans.Any())
        {
            <div class="card-body text-muted">
                No hay préstamos que coincidan
                con los filtros seleccionados.
            </div>
        }

    </div>
}

@if (_isLoanLoading)
{
    <div class="text-center py-4">

        <div class="spinner-border
                    spinner-border-sm"
             role="status">
        </div>

        <span class="ms-2">
            Cargando información del préstamo...
        </span>

    </div>
}
else if (_selectedLoan is not null &&
         _summary is not null)
{
    <div class="card mb-4">

        <div class="card-header">

            <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-start
                        gap-2">

                <div>

                    <strong>
                        @_selectedLoan.ClientName
                    </strong>

                    <div class="small text-muted">
                        Inversionista:
                        @_selectedLoan.InvestorName
                    </div>

                </div>

                <div class="d-flex
                            align-items-center
                            gap-2">

                    <span class="@StatusBadgeClass(
                        _selectedLoan.Status)">

                        @StatusText(
                            _selectedLoan.Status)

                    </span>

                    <button type="button"
                            class="btn-close"
                            aria-label="Cerrar"
                            @onclick="ClearSelectedLoan">
                    </button>

                </div>

            </div>

        </div>

        <div class="card-body">

            <h2 class="h6 mb-3">
                Resumen financiero actual
            </h2>

            <div class="row g-3">

                <div class="col-12
                            col-md-6
                            col-xl-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted">
                            Saldo contractual
                        </div>

                        <div class="fs-5 fw-semibold">
                            @Money(
                                _summary.Balance)
                        </div>

                    </div>

                </div>

                <div class="col-12
                            col-md-6
                            col-xl-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted">
                            Mora pendiente
                        </div>

                        <div class="fs-5 fw-semibold">
                            @Money(
                                _summary.LateFeeBalance)
                        </div>

                    </div>

                </div>

                <div class="col-12
                            col-md-6
                            col-xl-4">

                    <div class="border rounded p-3 h-100">

                        <div class="small text-muted">
                            Total pendiente
                        </div>

                        <div class="fs-5 fw-semibold">
                            @Money(
                                _summary.TotalOutstanding)
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    @if (_settlement is not null)
    {
        <div class="card mb-4">

            <div class="card-header
                        d-flex
                        justify-content-between
                        align-items-center">

                <strong>
                    Liquidación anticipada registrada
                </strong>

                <span class="badge text-bg-success">
                    Completada
                </span>

            </div>

            <div class="card-body">

                <div class="row g-3 mb-4">

                    <div class="col-12 col-md-4">

                        <div class="small text-muted">
                            Fecha
                        </div>

                        <div class="fw-semibold">
                            @FormatDateTime(
                                _settlement.CreatedAt)
                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <div class="small text-muted">
                            Cuotas completadas
                        </div>

                        <div class="fw-semibold">
                            @_settlement.CompletedInstallments
                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <div class="small text-muted">
                            Beneficio aplicado
                        </div>

                        <div class="fw-semibold">
                            @DiscountDescription(
                                _settlement.DiscountType,
                                _settlement.DiscountValue)
                        </div>

                    </div>

                </div>

                <h3 class="h6 mb-3">
                    Valores antes de la liquidación
                </h3>

                <div class="row g-3 mb-4">

                    <div class="col-12
                                col-md-6
                                col-xl-3">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Saldo contractual
                            </div>

                            <div class="fw-semibold">
                                @Money(
                                    _settlement
                                        .ContractualBalanceBefore)
                            </div>

                        </div>

                    </div>

                    <div class="col-12
                                col-md-6
                                col-xl-3">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Mora
                            </div>

                            <div class="fw-semibold">
                                @Money(
                                    _settlement
                                        .LateFeeBalanceBefore)
                            </div>

                        </div>

                    </div>

                    <div class="col-12
                                col-md-6
                                col-xl-3">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Descuento concedido
                            </div>

                            <div class="fw-semibold text-success">
                                @Money(
                                    _settlement.DiscountAmount)
                            </div>

                        </div>

                    </div>

                    <div class="col-12
                                col-md-6
                                col-xl-3">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Efectivo recibido
                            </div>

                            <div class="fw-semibold">
                                @Money(
                                    _settlement.SettlementAmount)
                            </div>

                        </div>

                    </div>

                </div>

                <h3 class="h6 mb-3">
                    Aplicación del efectivo
                </h3>

                <div class="row g-3">

                    <div class="col-12 col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Aplicado a mora
                            </div>

                            <div class="fw-semibold">
                                @Money(
                                    _settlement.AppliedToLateFees)
                            </div>

                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <div class="border rounded p-3 h-100">

                            <div class="small text-muted">
                                Aplicado al préstamo
                            </div>

                            <div class="fw-semibold">
                                @Money(
                                    _settlement.AppliedToLoan)
                            </div>

                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <div class="border
                                    border-success
                                    rounded
                                    p-3
                                    h-100">

                            <div class="small text-muted">
                                Saldo después
                            </div>

                            <div class="fw-semibold text-success">
                                @Money(
                                    _settlement.TotalOutstandingAfter)
                            </div>

                        </div>

                    </div>

                </div>

                @if (_settlement.PaymentId.HasValue)
                {
                    <div class="mt-4">

                        <button type="button"
                                class="btn btn-outline-primary"
                                disabled="@_isReceiptLoading"
                                @onclick="() =>
                                    ViewReceiptAsync(
                                        _settlement
                                            .PaymentId
                                            .Value)">

                            @if (_isReceiptLoading)
                            {
                                <span class="spinner-border
                                             spinner-border-sm
                                             me-1"
                                      role="status">
                                </span>
                            }

                            <span class="bi bi-receipt me-1"
                                  aria-hidden="true">
                            </span>

                            Ver recibo

                        </button>

                    </div>
                }
                else
                {
                    <div class="alert alert-info mt-4 mb-0">
                        Esta liquidación no generó un pago porque
                        el descuento extinguió completamente el saldo
                        y no existía mora pendiente.
                    </div>
                }

            </div>

        </div>
    }
    else if (_selectedLoan.Status ==
             LoanStatus.Active)
    {
        <EditForm Model="_form"
                  OnValidSubmit="QuoteAsync">

            <DataAnnotationsValidator />

            <div class="card mb-4">

                <div class="card-header">
                    <strong>
                        Beneficio de liquidación anticipada
                    </strong>
                </div>

                <div class="card-body">

                    <div class="alert alert-info">
                        El préstamo debe tener al menos
                        <strong>6 cuotas completadas</strong>.
                        La elegibilidad y todos los valores financieros
                        serán calculados nuevamente por el servidor.
                    </div>

                    <div class="row g-3">

                        <div class="col-12 col-lg-6">

                            <label class="form-label">
                                Tipo de beneficio
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="_form.DiscountType"
                                         @bind-Value:after="DiscountTypeChanged">

                                <option value="@EarlySettlementDiscountType.InstallmentWaiver">
                                    Perdonar cuotas
                                </option>

                                <option value="@EarlySettlementDiscountType.PercentageDiscount">
                                    Descuento porcentual
                                </option>

                            </InputSelect>

                            <ValidationMessage
                                For="@(() =>
                                    _form.DiscountType)" />

                        </div>

                        <div class="col-12 col-lg-6">

                            @if (_form.DiscountType ==
                                 EarlySettlementDiscountType.InstallmentWaiver)
                            {
                                <label class="form-label">
                                    Cuotas a perdonar
                                </label>

                                <InputSelect class="form-select"
                                             @bind-Value="_form.DiscountValue"
                                             @bind-Value:after="InvalidateQuote">

                                    <option value="1">
                                        1 cuota
                                    </option>

                                    <option value="2">
                                        2 cuotas
                                    </option>

                                    <option value="3">
                                        3 cuotas
                                    </option>

                                </InputSelect>
                            }
                            else
                            {
                                <label class="form-label">
                                    Porcentaje de descuento
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 min="0.01"
                                                 max="100"
                                                 step="0.01"
                                                 @bind-Value="_form.DiscountValue"
                                                 @bind-Value:after="InvalidateQuote" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>
                            }

                            <ValidationMessage
                                For="@(() =>
                                    _form.DiscountValue)" />

                        </div>

                    </div>

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@(_isQuoting ||
                                            _isExecuting)">

                            @if (_isQuoting)
                            {
                                <span class="spinner-border
                                             spinner-border-sm
                                             me-1"
                                      role="status">
                                </span>

                                <span>
                                    Cotizando...
                                </span>
                            }
                            else
                            {
                                <span class="bi bi-calculator me-1"
                                      aria-hidden="true">
                                </span>

                                <span>
                                    @(_quote is null
                                        ? "Cotizar liquidación"
                                        : "Actualizar cotización")
                                </span>
                            }

                        </button>

                    </div>

                </div>

            </div>

            @if (_quote is not null)
            {
                <div class="card
                            border-primary
                            mb-4">

                    <div class="card-header
                                d-flex
                                flex-wrap
                                justify-content-between
                                align-items-center
                                gap-2">

                        <strong>
                            Cotización
                        </strong>

                        <span class="badge text-bg-success">
                            Elegible
                        </span>

                    </div>

                    <div class="card-body">

                        <div class="row g-3 mb-4">

                            <div class="col-12 col-md-4">

                                <div class="small text-muted">
                                    Cuotas completadas
                                </div>

                                <div class="fs-5 fw-semibold">
                                    @_quote.CompletedInstallments
                                </div>

                            </div>

                            <div class="col-12 col-md-4">

                                <div class="small text-muted">
                                    Mínimo requerido
                                </div>

                                <div class="fs-5 fw-semibold">
                                    @_quote.MinimumRequiredInstallments
                                </div>

                            </div>

                            <div class="col-12 col-md-4">

                                <div class="small text-muted">
                                    Cotizada
                                </div>

                                <div class="fw-semibold">
                                    @FormatDateTime(
                                        _quote.QuotedAt)
                                </div>

                            </div>

                        </div>

                        <div class="row g-3">

                            <div class="col-12
                                        col-md-6
                                        col-xl-3">

                                <div class="border
                                            rounded
                                            p-3
                                            h-100">

                                    <div class="small text-muted">
                                        Saldo contractual
                                    </div>

                                    <div class="fs-5 fw-semibold">
                                        @Money(
                                            _quote.ContractualBalance)
                                    </div>

                                </div>

                            </div>

                            <div class="col-12
                                        col-md-6
                                        col-xl-3">

                                <div class="border
                                            rounded
                                            p-3
                                            h-100">

                                    <div class="small text-muted">
                                        Mora pendiente
                                    </div>

                                    <div class="fs-5 fw-semibold">
                                        @Money(
                                            _quote.LateFeeBalance)
                                    </div>

                                </div>

                            </div>

                            <div class="col-12
                                        col-md-6
                                        col-xl-3">

                                <div class="border
                                            rounded
                                            p-3
                                            h-100">

                                    <div class="small text-muted">
                                        Total antes del beneficio
                                    </div>

                                    <div class="fs-5 fw-semibold">
                                        @Money(
                                            _quote.TotalOutstanding)
                                    </div>

                                </div>

                            </div>

                            <div class="col-12
                                        col-md-6
                                        col-xl-3">

                                <div class="border
                                            border-success
                                            rounded
                                            p-3
                                            h-100">

                                    <div class="small text-muted">
                                        Descuento
                                    </div>

                                    <div class="fs-5
                                                fw-semibold
                                                text-success">
                                        @Money(
                                            _quote.DiscountAmount)
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="border
                                    rounded
                                    bg-body-tertiary
                                    p-4
                                    mt-4">

                            <div class="row
                                        align-items-center
                                        g-3">

                                <div class="col-12 col-lg-7">

                                    <div class="text-muted">
                                        Monto final que debe entregar
                                        el cliente
                                    </div>

                                    <div class="display-6 fw-semibold">
                                        @Money(
                                            _quote.SettlementAmount)
                                    </div>

                                </div>

                                <div class="col-12
                                            col-lg-5
                                            text-lg-end">

                                    <div>
                                        <span class="text-muted">
                                            Beneficio:
                                        </span>

                                        <strong>
                                            @DiscountDescription(
                                                _quote.DiscountType,
                                                _quote.DiscountValue)
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>

                        @if (_quote.LateFeeBalance > 0)
                        {
                            <div class="alert
                                        alert-warning
                                        mt-4
                                        mb-0">

                                La mora pendiente no recibe el descuento.
                                El monto de
                                <strong>
                                    @Money(_quote.LateFeeBalance)
                                </strong>
                                debe ser pagado completamente durante
                                la liquidación.

                            </div>
                        }

                        <hr class="my-4" />

                        <h3 class="h6">
                            Confirmación
                        </h3>

                        <p class="text-muted">
                            Esta operación aplicará el descuento,
                            registrará el pago correspondiente y
                            cerrará el préstamo como pagado.
                        </p>

                        <div class="mb-3">

                            <label class="form-label">
                                Motivo de la liquidación
                            </label>

                            <InputTextArea
                                class="form-control"
                                rows="3"
                                maxlength="500"
                                placeholder="Indica el motivo o autorización del beneficio concedido."
                                @bind-Value="_form.Reason" />

                            <ValidationMessage
                                For="@(() =>
                                    _form.Reason)" />

                            <div class="form-text">
                                Máximo 500 caracteres.
                            </div>

                        </div>

                        <div class="form-check mb-4">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="confirmEarlySettlement"
                                   @bind="_confirmationAccepted" />

                            <label class="form-check-label"
                                   for="confirmEarlySettlement">

                                Confirmo que revisé la cotización
                                y autorizo la liquidación anticipada.

                            </label>

                        </div>

                        <button type="button"
                                class="btn btn-success"
                                disabled="@(_isExecuting ||
                                            _isQuoting ||
                                            !_confirmationAccepted)"
                                @onclick="ExecuteAsync">

                            @if (_isExecuting)
                            {
                                <span class="spinner-border
                                             spinner-border-sm
                                             me-1"
                                      role="status">
                                </span>

                                <span>
                                    Liquidando...
                                </span>
                            }
                            else
                            {
                                <span class="bi bi-check-circle me-1"
                                      aria-hidden="true">
                                </span>

                                <span>
                                    Confirmar liquidación anticipada
                                </span>
                            }

                        </button>

                    </div>

                </div>
            }

        </EditForm>
    }
    else if (_selectedLoan.Status ==
             LoanStatus.Paid)
    {
        <div class="alert alert-info">
            Este préstamo ya está pagado y no posee
            una liquidación anticipada registrada.
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            Un préstamo cancelado no puede ser
            liquidado anticipadamente.
        </div>
    }
}

@code
{
    private List<LoanResponse> _loans = [];

    private TenantDto? _tenant;

    private LoanResponse? _selectedLoan;

    private LoanFinancialSummaryResponse? _summary;

    private EarlySettlementQuoteResponse? _quote;

    private EarlySettlementResponse? _settlement;

    private PaymentReceiptResponse? _selectedReceipt;

    private EarlySettlementFormModel _form = new();

    private string _search = string.Empty;

    private string _statusFilter = "active";

    private string? _pageMessage;

    private string? _warningMessage;

    private string? _successMessage;

    private bool _isLoading;

    private bool _isLoanLoading;

    private bool _isQuoting;

    private bool _isExecuting;

    private bool _isReceiptLoading;

    private bool _confirmationAccepted;

    private IEnumerable<LoanResponse>
        FilteredLoans
    {
        get
        {
            IEnumerable<LoanResponse> result =
                _loans;

            result =
                _statusFilter switch
                {
                    "active" =>
                        result.Where(
                            x =>
                                x.Status ==
                                LoanStatus.Active),

                    "paid" =>
                        result.Where(
                            x =>
                                x.Status ==
                                LoanStatus.Paid),

                    "cancelled" =>
                        result.Where(
                            x =>
                                x.Status ==
                                LoanStatus.Cancelled),

                    _ =>
                        result
                };

            if (!string.IsNullOrWhiteSpace(
                _search))
            {
                var search =
                    _search.Trim();

                result =
                    result.Where(
                        x =>
                            x.ClientName.Contains(
                                search,
                                StringComparison
                                    .OrdinalIgnoreCase) ||
                            x.InvestorName.Contains(
                                search,
                                StringComparison
                                    .OrdinalIgnoreCase));
            }

            return result
                .OrderBy(
                    x => x.ClientName)
                .ThenByDescending(
                    x => x.CreatedAt);
        }
    }

    protected override async Task
        OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _pageMessage = null;

        try
        {
            _tenant =
                await LoansService
                    .GetTenantAsync();

            _loans =
                await LoansService
                    .GetAllAsync();
        }
        catch (ArgumentException ex)
        {
            _pageMessage =
                ex.Message;
        }
        catch (Exception)
        {
            _pageMessage =
                "No fue posible cargar los préstamos.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadAsync()
    {
        var selectedLoanId =
            _selectedLoan?.Id;

        ClearMessages();

        await LoadAsync();

        if (selectedLoanId.HasValue)
        {
            await SelectLoanAsync(
                selectedLoanId.Value);
        }
    }

    private async Task SelectLoanAsync(
        Guid loanId)
    {
        _isLoanLoading = true;

        ClearMessages();

        _quote = null;
        _settlement = null;
        _selectedReceipt = null;
        _confirmationAccepted = false;

        try
        {
            var loan =
                await LoansService
                    .GetByIdAsync(
                        loanId);

            if (loan is null)
            {
                _pageMessage =
                    "El préstamo seleccionado no fue encontrado.";

                ClearSelectedLoan();

                return;
            }

            var summary =
                await LoansService
                    .GetFinancialSummaryAsync(
                        loanId);

            if (summary is null)
            {
                _pageMessage =
                    "No fue posible obtener el resumen financiero del préstamo.";

                ClearSelectedLoan();

                return;
            }

            var settlement =
                await EarlySettlementsService
                    .GetByLoanAsync(
                        loanId);

            _selectedLoan =
                loan;

            _summary =
                summary;

            _settlement =
                settlement;

            _form =
                EarlySettlementFormModel
                    .ForLoan(
                        loan.Id);
        }
        catch (ArgumentException ex)
        {
            _pageMessage =
                ex.Message;
        }
        catch (Exception)
        {
            _pageMessage =
                "No fue posible cargar la información del préstamo.";
        }
        finally
        {
            _isLoanLoading = false;
        }
    }

    private async Task QuoteAsync()
    {
        if (_selectedLoan is null)
        {
            return;
        }

        if (_selectedLoan.Status !=
            LoanStatus.Active)
        {
            _pageMessage =
                "Solo los préstamos activos pueden liquidarse anticipadamente.";

            return;
        }

        _isQuoting = true;

        _pageMessage = null;
        _warningMessage = null;
        _successMessage = null;
        _quote = null;
        _confirmationAccepted = false;
        _selectedReceipt = null;

        try
        {
            var quote =
                await EarlySettlementsService
                    .QuoteAsync(
                        _selectedLoan.Id,
                        _form.ToQuoteRequest());

            if (quote is null)
            {
                _pageMessage =
                    "El préstamo seleccionado no fue encontrado.";

                return;
            }

            _quote =
                quote;
        }
        catch (ArgumentException ex)
        {
            _pageMessage =
                ex.Message;
        }
        catch (Exception)
        {
            _pageMessage =
                "No fue posible generar la cotización de liquidación anticipada.";
        }
        finally
        {
            _isQuoting = false;
        }
    }

    private async Task ExecuteAsync()
    {
        if (_selectedLoan is null ||
            _quote is null)
        {
            return;
        }

        if (!_confirmationAccepted)
        {
            _pageMessage =
                "Debes confirmar que revisaste la cotización.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            _form.Reason))
        {
            _pageMessage =
                "Debes indicar el motivo de la liquidación anticipada.";

            return;
        }

        _isExecuting = true;

        _pageMessage = null;
        _warningMessage = null;
        _successMessage = null;
        _selectedReceipt = null;

        try
        {
            var settlement =
                await EarlySettlementsService
                    .ExecuteAsync(
                        _selectedLoan.Id,
                        _form.ToExecuteRequest(
                            _quote));

            if (settlement is null)
            {
                _pageMessage =
                    "El préstamo seleccionado no fue encontrado.";

                return;
            }

            var loanId =
                settlement.LoanId;

            await RefreshSelectedLoanAsync(
                loanId);

            _settlement =
                settlement;

            _quote =
                null;

            _confirmationAccepted =
                false;

            if (settlement.PaymentId.HasValue)
            {
                var receipt =
                    await ReceiptsService
                        .GetByPaymentAsync(
                            settlement.PaymentId.Value);

                if (receipt is null)
                {
                    _successMessage =
                        "La liquidación anticipada fue completada correctamente.";

                    _warningMessage =
                        "La liquidación generó un pago, pero no fue posible recuperar el recibo.";

                    return;
                }

                _selectedReceipt =
                    receipt;

                _successMessage =
                    $"Liquidación anticipada completada correctamente. Recibo {receipt.ReceiptNumber}.";
            }
            else
            {
                _successMessage =
                    "Liquidación anticipada completada correctamente. " +
                    "No fue necesario registrar efectivo porque el monto final fue cero.";
            }
        }
        catch (InvalidOperationException ex)
        {
            _pageMessage =
                ex.Message;
        }
        catch (ArgumentException ex)
        {
            _pageMessage =
                ex.Message;

            _confirmationAccepted =
                false;
        }
        catch (Exception)
        {
            _pageMessage =
                "No fue posible completar la liquidación anticipada.";

            _confirmationAccepted =
                false;
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private async Task RefreshSelectedLoanAsync(
        Guid loanId)
    {
        _loans =
            await LoansService
                .GetAllAsync();

        var loan =
            await LoansService
                .GetByIdAsync(
                    loanId);

        var summary =
            await LoansService
                .GetFinancialSummaryAsync(
                    loanId);

        var settlement =
            await EarlySettlementsService
                .GetByLoanAsync(
                    loanId);

        _selectedLoan =
            loan;

        _summary =
            summary;

        _settlement =
            settlement;
    }

    private async Task ViewReceiptAsync(
        Guid paymentId)
    {
        _isReceiptLoading = true;
        _pageMessage = null;

        try
        {
            var receipt =
                await ReceiptsService
                    .GetByPaymentAsync(
                        paymentId);

            if (receipt is null)
            {
                _pageMessage =
                    "No fue posible encontrar el recibo de esta liquidación.";

                return;
            }

            _selectedReceipt =
                receipt;
        }
        catch (ArgumentException ex)
        {
            _pageMessage =
                ex.Message;
        }
        catch (Exception)
        {
            _pageMessage =
                "No fue posible cargar el recibo.";
        }
        finally
        {
            _isReceiptLoading = false;
        }
    }

    private Task CloseReceiptAsync()
    {
        _selectedReceipt = null;

        return Task.CompletedTask;
    }

    private void DiscountTypeChanged()
    {
        _form.DiscountValue =
            _form.DiscountType ==
            EarlySettlementDiscountType
                .InstallmentWaiver
                ? 1m
                : 10m;

        InvalidateQuote();
    }

    private void InvalidateQuote()
    {
        _quote = null;
        _confirmationAccepted = false;
        _pageMessage = null;
        _warningMessage = null;
        _successMessage = null;
    }

    private void ClearFilters()
    {
        _search =
            string.Empty;

        _statusFilter =
            "active";
    }

    private void ClearSelectedLoan()
    {
        _selectedLoan = null;
        _summary = null;
        _quote = null;
        _settlement = null;
        _selectedReceipt = null;
        _confirmationAccepted = false;
        _form = new();
    }

    private void ClearMessages()
    {
        _pageMessage = null;
        _warningMessage = null;
        _successMessage = null;
    }

    private string SelectedRowClass(
        Guid loanId)
    {
        return _selectedLoan?.Id ==
            loanId
                ? "table-primary"
                : string.Empty;
    }

    private string Money(
        decimal amount)
    {
        var symbol =
            _tenant?.CurrencySymbol;

        if (string.IsNullOrWhiteSpace(
            symbol))
        {
            symbol =
                _tenant?.CurrencyCode;
        }

        if (string.IsNullOrWhiteSpace(
            symbol))
        {
            return amount.ToString(
                "N2");
        }

        return
            $"{symbol} {amount:N2}";
    }

    private static string FormatDate(
        DateTime value)
    {
        return value.ToString(
            "dd/MM/yyyy");
    }

    private static string FormatDateTime(
        DateTime value)
    {
        return value
            .ToLocalTime()
            .ToString(
                "dd/MM/yyyy HH:mm");
    }

    private static string DiscountDescription(
        EarlySettlementDiscountType discountType,
        decimal discountValue)
    {
        return discountType switch
        {
            EarlySettlementDiscountType
                .InstallmentWaiver =>
                discountValue == 1m
                    ? "Perdón de 1 cuota"
                    : $"Perdón de {discountValue:0} cuotas",

            EarlySettlementDiscountType
                .PercentageDiscount =>
                $"{discountValue:0.##}% de descuento",

            _ =>
                discountType.ToString()
        };
    }

    private static string StatusText(
        LoanStatus status)
    {
        return status switch
        {
            LoanStatus.Active =>
                "Activo",

            LoanStatus.Paid =>
                "Pagado",

            LoanStatus.Cancelled =>
                "Cancelado",

            _ =>
                status.ToString()
        };
    }

    private static string StatusBadgeClass(
        LoanStatus status)
    {
        return status switch
        {
            LoanStatus.Active =>
                "badge text-bg-success",

            LoanStatus.Paid =>
                "badge text-bg-primary",

            LoanStatus.Cancelled =>
                "badge text-bg-secondary",

            _ =>
                "badge text-bg-secondary"
        };
    }
}