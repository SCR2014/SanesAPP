@page "/admin/settings"

@attribute [Authorize(Roles = WebRoles.Administrator)]
@rendermode InteractiveServer

@inject ITenantSettingsWebService TenantSettingsService

<PageTitle>Configuración del negocio - Sanes</PageTitle>

<div class="d-flex flex-wrap
            justify-content-between
            align-items-start
            gap-3
            mb-4">

    <div>
        <h1 class="mb-1">
            Configuración del negocio
        </h1>

        <p class="text-muted mb-0">
            Administra la información general,
            la moneda y las políticas predeterminadas
            de tu empresa.
        </p>
    </div>

    <button type="button"
            class="btn btn-outline-secondary"
            disabled="@(_isLoading || _isSaving)"
            @onclick="ReloadAsync">

        <span class="bi bi-arrow-clockwise me-1"
              aria-hidden="true">
        </span>

        Actualizar

    </button>

</div>

@if (!string.IsNullOrWhiteSpace(
    _pageMessage))
{
    <div class="alert
                @(_pageMessageIsError
                    ? "alert-danger"
                    : "alert-success")">

        @_pageMessage

    </div>
}

@if (_isLoading)
{
    <div class="py-5 text-center">

        <div class="spinner-border"
             role="status">
        </div>

        <p class="text-muted mt-3">
            Cargando configuración del negocio...
        </p>

    </div>
}
else if (_tenant is null)
{
    <div class="alert alert-warning">

        No fue posible encontrar la configuración
        correspondiente a la empresa autenticada.

    </div>
}
else
{
    <EditForm Model="_form"
              OnValidSubmit="SaveAsync">

        <DataAnnotationsValidator />

        <ValidationSummary />

        <div class="card mb-4">

            <div class="card-header">

                <strong>
                    Información de la empresa
                </strong>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-12 col-lg-6">

                        <label class="form-label">
                            Nombre comercial
                        </label>

                        <InputText class="form-control"
                                   maxlength="150"
                                   @bind-Value="_form.Name" />

                        <ValidationMessage
                            For="@(() => _form.Name)" />

                    </div>

                    <div class="col-12 col-lg-6">

                        <label class="form-label">
                            Razón social
                        </label>

                        <InputText class="form-control"
                                   maxlength="200"
                                   @bind-Value="_form.LegalName" />

                        <ValidationMessage
                            For="@(() => _form.LegalName)" />

                    </div>

                    <div class="col-12 col-lg-6">

                        <label class="form-label">
                            Teléfono
                        </label>

                        <InputText class="form-control"
                                   maxlength="30"
                                   @bind-Value="_form.Phone" />

                        <ValidationMessage
                            For="@(() => _form.Phone)" />

                    </div>

                    <div class="col-12 col-lg-6">

                        <label class="form-label">
                            Correo electrónico
                        </label>

                        <InputText class="form-control"
                                   type="email"
                                   maxlength="150"
                                   @bind-Value="_form.Email" />

                        <ValidationMessage
                            For="@(() => _form.Email)" />

                    </div>

                </div>

            </div>

        </div>

        <div class="card mb-4">

            <div class="card-header">

                <strong>
                    Moneda
                </strong>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            Código de moneda
                        </label>

                        <InputText class="form-control"
                                   maxlength="3"
                                   @bind-Value="_form.CurrencyCode" />

                        <ValidationMessage
                            For="@(() =>
                                _form.CurrencyCode)" />

                        <div class="form-text">
                            Código ISO de tres caracteres.
                            Ejemplos: DOP, USD, EUR.
                        </div>

                    </div>

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            Símbolo de moneda
                        </label>

                        <InputText class="form-control"
                                   maxlength="10"
                                   @bind-Value="_form.CurrencySymbol" />

                        <ValidationMessage
                            For="@(() =>
                                _form.CurrencySymbol)" />

                        <div class="form-text">
                            Ejemplos: RD$, $, €.
                        </div>

                    </div>

                </div>

                <div class="alert alert-warning mt-4 mb-0">

                    <strong>
                        Importante:
                    </strong>

                    cambiar la moneda no convierte
                    automáticamente los valores financieros
                    ya registrados en el sistema.

                </div>

            </div>

        </div>

        <div class="card mb-4">

            <div class="card-header">

                <strong>
                    Política predeterminada de mora
                </strong>

            </div>

            <div class="card-body">

                <div class="form-check form-switch mb-4">

                    <InputCheckbox class="form-check-input"
                                   id="defaultLateFeeEnabled"
                                   @bind-Value="_form.DefaultLateFeeEnabled" />

                    <label class="form-check-label"
                           for="defaultLateFeeEnabled">

                        Habilitar mora predeterminada
                        para nuevos préstamos

                    </label>

                </div>

                <div class="row g-3">

                    <div class="col-12 col-lg-4">

                        <label class="form-label">
                            Tipo de cálculo
                        </label>

                        <input type="text"
                               class="form-control"
                               value="Monto fijo por cuota vencida"
                               disabled />

                        <div class="form-text">
                            Es el método de cálculo
                            actualmente soportado.
                        </div>

                    </div>

                    <div class="col-12 col-lg-4">

                        <label class="form-label">
                            Monto de mora
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                @DisplayCurrencySymbol
                            </span>

                            <InputNumber class="form-control"
                                         min="0"
                                         step="0.01"
                                         disabled="@(!_form.DefaultLateFeeEnabled)"
                                         @bind-Value="_form.DefaultLateFeeAmount" />

                        </div>

                        <ValidationMessage
                            For="@(() =>
                                _form.DefaultLateFeeAmount)" />

                        <div class="form-text">
                            Monto aplicado por cada cuota
                            vencida según la política
                            predeterminada.
                        </div>

                    </div>

                    <div class="col-12 col-lg-4">

                        <label class="form-label">
                            Días de gracia
                        </label>

                        <InputNumber class="form-control"
                                     min="0"
                                     step="1"
                                     disabled="@(!_form.DefaultLateFeeEnabled)"
                                     @bind-Value="_form.DefaultLateFeeGraceDays" />

                        <ValidationMessage
                            For="@(() =>
                                _form.DefaultLateFeeGraceDays)" />

                        <div class="form-text">
                            Cantidad de días antes de comenzar
                            a generar la mora.
                        </div>

                    </div>

                </div>

                @if (!_form.DefaultLateFeeEnabled)
                {
                    <div class="alert alert-light border mt-4 mb-0">

                        La mora predeterminada está
                        deshabilitada. Los nuevos préstamos
                        no utilizarán esta política de forma
                        automática.

                    </div>
                }

            </div>

        </div>

        <div class="card mb-4">

            <div class="card-header">

                <strong>
                    Política de garantía
                </strong>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-12 col-lg-6">

                        <label class="form-label">
                            Exigir garantía desde
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                @DisplayCurrencySymbol
                            </span>

                            <InputNumber class="form-control"
                                         min="0.01"
                                         step="0.01"
                                         @bind-Value="_form.GuaranteeRequiredFromAmount" />

                        </div>

                        <ValidationMessage
                            For="@(() =>
                                _form.GuaranteeRequiredFromAmount)" />

                        <div class="form-text">
                            Si se deja vacío, no existirá
                            una exigencia automática de
                            garantía basada en el monto
                            del préstamo.
                        </div>

                    </div>

                </div>

                @if (!_form.GuaranteeRequiredFromAmount.HasValue)
                {
                    <div class="alert alert-light border mt-4 mb-0">

                        Actualmente no existe un monto
                        mínimo configurado para exigir
                        garantía automáticamente.

                    </div>
                }

            </div>

        </div>

        <div class="card mb-4">

            <div class="card-header">

                <strong>
                    Información del registro
                </strong>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-12 col-md-4">

                        <div class="text-muted small">
                            Estado
                        </div>

                        <div class="mt-1">

                            @if (_tenant.IsActive)
                            {
                                <span class="badge text-bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">
                                    Inactivo
                                </span>
                            }

                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <div class="text-muted small">
                            Creado
                        </div>

                        <div class="mt-1">
                            @FormatDateTime(
                                _tenant.CreatedAt)
                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <div class="text-muted small">
                            Última actualización
                        </div>

                        <div class="mt-1">
                            @FormatDateTime(
                                _tenant.UpdatedAt)
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex
                    flex-wrap
                    gap-2
                    align-items-center
                    mb-5">

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@_isSaving">

                @if (_isSaving)
                {
                    <span class="spinner-border
                                 spinner-border-sm
                                 me-1"
                          role="status">
                    </span>
                }

                Guardar configuración

            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@_isSaving"
                    @onclick="ResetForm">

                Descartar cambios

            </button>

        </div>

    </EditForm>
}

@code
{
    private TenantDto? _tenant;

    private TenantSettingsFormModel _form =
        new();

    private bool _isLoading =
        true;

    private bool _isSaving;

    private string? _pageMessage;

    private bool _pageMessageIsError;

    private string DisplayCurrencySymbol
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(
                    _form.CurrencySymbol))
            {
                return _form.CurrencySymbol.Trim();
            }

            return "$";
        }
    }

    protected override async Task
        OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading =
            true;

        ClearMessage();

        try
        {
            _tenant =
                await TenantSettingsService
                    .GetCurrentAsync();

            if (_tenant is null)
            {
                SetError(
                    "No fue posible encontrar la configuración de la empresa.");

                return;
            }

            _form =
                TenantSettingsFormModel
                    .FromDto(
                        _tenant);
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible cargar la configuración del negocio.");
        }
        catch (InvalidOperationException ex)
        {
            SetError(
                ex.Message);
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al cargar la configuración del negocio.");
        }
        finally
        {
            _isLoading =
                false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (_tenant is null)
        {
            return;
        }

        ClearMessage();

        _isSaving =
            true;

        try
        {
            var updated =
                await TenantSettingsService
                    .UpdateCurrentAsync(
                        _form.ToUpdateRequest());

            if (updated is null)
            {
                SetError(
                    "La configuración de la empresa ya no se encuentra disponible.");

                return;
            }

            _tenant =
                updated;

            _form =
                TenantSettingsFormModel
                    .FromDto(
                        updated);

            SetSuccess(
                "Configuración del negocio actualizada correctamente.");
        }
        catch (ArgumentException ex)
        {
            SetError(
                ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            SetError(
                ex.Message);
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible guardar la configuración del negocio.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al guardar la configuración del negocio.");
        }
        finally
        {
            _isSaving =
                false;
        }
    }

    private void ResetForm()
    {
        if (_tenant is null)
        {
            return;
        }

        ClearMessage();

        _form =
            TenantSettingsFormModel
                .FromDto(
                    _tenant);
    }

    private static string FormatDateTime(
        DateTime value)
    {
        return value
            .ToLocalTime()
            .ToString(
                "dd/MM/yyyy HH:mm");
    }

    private void SetSuccess(
        string message)
    {
        _pageMessage =
            message;

        _pageMessageIsError =
            false;
    }

    private void SetError(
        string message)
    {
        _pageMessage =
            message;

        _pageMessageIsError =
            true;
    }

    private void ClearMessage()
    {
        _pageMessage =
            null;
    }
}