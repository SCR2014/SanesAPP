@page "/admin/clients"

@attribute [Authorize(Roles = WebRoles.Administrator)]
@rendermode InteractiveServer

@inject IClientsWebService ClientsService

<PageTitle>Clientes - Sanes</PageTitle>

<div class="d-flex flex-wrap
            justify-content-between
            align-items-start
            gap-3
            mb-4">

    <div>
        <h1 class="mb-1">
            Clientes
        </h1>

        <p class="text-muted mb-0">
            Administración de clientes
            del tenant actual.
        </p>
    </div>

    <button type="button"
            class="btn btn-primary"
            @onclick="OpenCreate">

        Nuevo cliente

    </button>

</div>

@if (!string.IsNullOrWhiteSpace(
    _pageMessage))
{
    <div class="alert
                @(_pageMessageIsError
                    ? "alert-danger"
                    : "alert-success")">

        @_pageMessage

    </div>
}

<div class="card mb-4">

    <div class="card-body">

        <div class="row g-3 align-items-end">

            <div class="col-12 col-lg-5">

                <label class="form-label">
                    Buscar
                </label>

                <input class="form-control"
                       placeholder="Nombre, teléfono, identificación o dirección"
                       @bind="_search"
                       @bind:event="oninput" />

            </div>

            <div class="col-12 col-md-6 col-lg-4">

                <label class="form-label">
                    Ruta
                </label>

                <select class="form-select"
                        @bind="_routeFilter">

                    <option value="">
                        Todas las rutas
                    </option>

                    @foreach (var route in _routes)
                    {
                        <option value="@route.Id">
                            @route.Name
                        </option>
                    }

                </select>

            </div>

            <div class="col-12 col-md-6 col-lg-3">

                <div class="form-check mb-2">

                    <input class="form-check-input"
                           type="checkbox"
                           id="showInactiveClients"
                           @bind="_showInactive" />

                    <label class="form-check-label"
                           for="showInactiveClients">

                        Mostrar inactivos

                    </label>

                </div>

            </div>

        </div>

    </div>

</div>

@if (_isLoading)
{
    <div class="py-5 text-center">

        <div class="spinner-border"
             role="status">
        </div>

        <p class="text-muted mt-3">
            Cargando clientes...
        </p>

    </div>
}
else if (_clients.Count == 0)
{
    <div class="alert alert-info">
        No existen clientes registrados.
    </div>
}
else
{
    var filtered =
        FilteredClients.ToList();

    if (filtered.Count == 0)
    {
        <div class="alert alert-info">
            No existen clientes que coincidan
            con los filtros seleccionados.
        </div>
    }
    else
    {
        <div class="card mb-4">

            <div class="table-responsive">

                <table class="table
                              table-hover
                              align-middle
                              mb-0">

                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Teléfono</th>
                            <th>Identificación</th>
                            <th>Ruta</th>
                            <th>Dirección</th>
                            <th>Estado</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (
                            var client in filtered)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @FullName(client)
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        client.SecondaryPhone))
                                    {
                                        <div class="small text-muted">
                                            Secundario:
                                            @client.SecondaryPhone
                                        </div>
                                    }
                                </td>

                                <td>
                                    @client.Phone
                                </td>

                                <td>
                                    @DisplayValue(
                                        client.Identification)
                                </td>

                                <td>
                                    @RouteName(
                                        client.CollectionRouteId)
                                </td>

                                <td>
                                    @DisplayValue(
                                        client.Address)
                                </td>

                                <td>
                                    @if (client.IsActive)
                                    {
                                        <span class="badge
                                                     text-bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                     text-bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    @if (client.IsActive)
                                    {
                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-primary
                                                       me-2"
                                                @onclick="() =>
                                                    OpenEdit(client)">

                                            Editar

                                        </button>

                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-danger"
                                                @onclick="() =>
                                                    RequestDelete(client)">

                                            Desactivar

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn
                                                       btn-sm
                                                       btn-outline-success"
                                                disabled="@_isSaving"
                                                @onclick="() =>
                                                    ReactivateAsync(client)">

                                            Reactivar

                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
}

@if (_pendingDeleteClient is not null)
{
    <div class="alert alert-warning">

        <h2 class="h5">
            Confirmar desactivación
        </h2>

        <p>
            ¿Deseas desactivar al cliente
            <strong>
                @FullName(_pendingDeleteClient)
            </strong>?
        </p>

        <button type="button"
                class="btn btn-danger me-2"
                disabled="@_isSaving"
                @onclick="ConfirmDeleteAsync">

            Confirmar

        </button>

        <button type="button"
                class="btn btn-outline-secondary"
                disabled="@_isSaving"
                @onclick="CancelDelete">

            Cancelar

        </button>

    </div>
}

@if (_showForm)
{
    <div class="card mb-4">

        <div class="card-header">

            <strong>
                @(_editingClient is null
                    ? "Nuevo cliente"
                    : "Editar cliente")
            </strong>

        </div>

        <div class="card-body">

            <ClientForm
                Model="_formModel"
                Routes="_routes"
                IsSaving="_isSaving"
                SubmitText="@(_editingClient is null
                    ? "Guardar"
                    : "Guardar cambios")"
                OnValidSubmit="SaveAsync"
                OnCancel="CloseForm" />

        </div>

    </div>
}

@code {
    private List<ClientResponse> _clients =
        new();

    private List<CollectionRouteResponse> _routes =
        new();

    private string _search =
        string.Empty;

    private Guid? _routeFilter;

    private bool _showInactive;

    private bool _isLoading = true;

    private bool _isSaving;

    private bool _showForm;

    private ClientResponse?
        _editingClient;

    private ClientResponse?
        _pendingDeleteClient;

    private ClientFormModel _formModel =
        new();

    private string? _pageMessage;

    private bool _pageMessageIsError;

    private IEnumerable<ClientResponse>
        FilteredClients
    {
        get
        {
            IEnumerable<ClientResponse> query =
                _clients;

            if (!_showInactive)
            {
                query =
                    query.Where(x =>
                        x.IsActive);
            }

            if (_routeFilter.HasValue)
            {
                query =
                    query.Where(x =>
                        x.CollectionRouteId ==
                        _routeFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(
                _search))
            {
                var search =
                    _search.Trim();

                query =
                    query.Where(x =>
                        Contains(
                            x.FirstName,
                            search) ||
                        Contains(
                            x.LastName,
                            search) ||
                        Contains(
                            x.Phone,
                            search) ||
                        Contains(
                            x.SecondaryPhone,
                            search) ||
                        Contains(
                            x.Identification,
                            search) ||
                        Contains(
                            x.SocialNumber,
                            search) ||
                        Contains(
                            x.Address,
                            search));
            }

            return query
                .OrderByDescending(x =>
                    x.IsActive)
                .ThenBy(x =>
                    x.FirstName)
                .ThenBy(x =>
                    x.LastName);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            _routes =
                await ClientsService
                    .GetRoutesAsync();

            _clients =
                await ClientsService
                    .GetAllAsync(
                        includeInactive: true);
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible cargar los clientes.");
        }
        catch (InvalidOperationException)
        {
            SetError(
                "La respuesta recibida desde la API no es válida.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al cargar los clientes.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadClientsAsync()
    {
        _clients =
            await ClientsService
                .GetAllAsync(
                    includeInactive: true);
    }

    private void OpenCreate()
    {
        ClearMessage();

        _editingClient = null;
        _pendingDeleteClient = null;

        _formModel =
            new ClientFormModel();

        _showForm = true;
    }

    private void OpenEdit(
        ClientResponse client)
    {
        ClearMessage();

        _pendingDeleteClient = null;
        _editingClient = client;

        _formModel =
            ClientFormModel.FromResponse(
                client);

        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _editingClient = null;
    }

    private async Task SaveAsync()
    {
        ClearMessage();

        _isSaving = true;

        try
        {
            if (_editingClient is null)
            {
                await ClientsService
                    .CreateAsync(
                        _formModel
                            .ToCreateRequest());

                SetSuccess(
                    "Cliente creado correctamente.");
            }
            else
            {
                var updated =
                    await ClientsService
                        .UpdateAsync(
                            _editingClient.Id,
                            _formModel
                                .ToUpdateRequest());

                if (updated is null)
                {
                    SetError(
                        "El cliente ya no existe o se encuentra inactivo.");

                    return;
                }

                SetSuccess(
                    "Cliente actualizado correctamente.");
            }

            _showForm = false;
            _editingClient = null;

            await ReloadClientsAsync();
        }
        catch (ArgumentException ex)
        {
            SetError(
                ex.Message);
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible guardar el cliente.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al guardar el cliente.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void RequestDelete(
        ClientResponse client)
    {
        ClearMessage();

        _showForm = false;
        _editingClient = null;

        _pendingDeleteClient =
            client;
    }

    private void CancelDelete()
    {
        _pendingDeleteClient = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDeleteClient is null)
        {
            return;
        }

        ClearMessage();

        _isSaving = true;

        try
        {
            var deleted =
                await ClientsService
                    .DeleteAsync(
                        _pendingDeleteClient.Id);

            if (!deleted)
            {
                SetError(
                    "El cliente no fue encontrado.");

                return;
            }

            _pendingDeleteClient = null;

            SetSuccess(
                "Cliente desactivado correctamente.");

            await ReloadClientsAsync();
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible desactivar el cliente.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al desactivar el cliente.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ReactivateAsync(
        ClientResponse client)
    {
        ClearMessage();

        _isSaving = true;

        try
        {
            var reactivated =
                await ClientsService
                    .ReactivateAsync(
                        client.Id);

            if (!reactivated)
            {
                SetError(
                    "El cliente no fue encontrado.");

                return;
            }

            SetSuccess(
                "Cliente reactivado correctamente.");

            await ReloadClientsAsync();
        }
        catch (HttpRequestException)
        {
            SetError(
                "No fue posible reactivar el cliente.");
        }
        catch (Exception)
        {
            SetError(
                "Ocurrió un error inesperado al reactivar el cliente.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string RouteName(
        Guid? routeId)
    {
        if (!routeId.HasValue)
        {
            return "Sin ruta";
        }

        return _routes
            .FirstOrDefault(x =>
                x.Id == routeId.Value)
            ?.Name
            ?? "Ruta no disponible";
    }

    private static string FullName(
        ClientResponse client)
    {
        return string.Join(
            " ",
            new[]
            {
                client.FirstName,
                client.LastName
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x)));
    }

    private static bool Contains(
        string? value,
        string search)
    {
        return !string.IsNullOrWhiteSpace(
            value) &&
            value.Contains(
                search,
                StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(
            value)
            ? "—"
            : value;
    }

    private void SetSuccess(
        string message)
    {
        _pageMessage = message;
        _pageMessageIsError = false;
    }

    private void SetError(
        string message)
    {
        _pageMessage = message;
        _pageMessageIsError = true;
    }

    private void ClearMessage()
    {
        _pageMessage = null;
    }
}