@page "/"

@attribute [Authorize]

<PageTitle>Inicio - Sanes</PageTitle>

<h1>Sanes</h1>

<AuthorizeView>
    <Authorized Context="authContext">
        <p class="lead">
            Bienvenido, @authContext.User.Identity?.Name.
        </p>

        <p class="text-muted">
            Selecciona una opción del menú para continuar.
        </p>
    </Authorized>
</AuthorizeView>