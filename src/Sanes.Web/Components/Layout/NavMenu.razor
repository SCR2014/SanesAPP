<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand"
           href="/">
            Sanes
        </a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href=""
                             Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu"
                              aria-hidden="true">
                        </span>
                        Inicio
                    </NavLink>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="login">
                        Iniciar sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView Roles="@WebRoles.Administrator">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                            href="admin/dashboard">
                        <span class="bi bi-speedometer2"
                            aria-hidden="true">
                        </span>
                        Dashboard
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                            href="admin/reports">
                        <span class="bi bi-file-earmark-text"
                            aria-hidden="true">
                        </span>
                        Reportes
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="admin"
                             Match="NavLinkMatch.All">
                        <span class="bi bi-grid-fill-nav-menu"
                              aria-hidden="true">
                        </span>
                        Administración
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@WebRoles.Collector">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="collector">
                        <span class="bi bi-list-nested-nav-menu"
                              aria-hidden="true">
                        </span>
                        Cobranza
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-3">
                    <form method="post"
                          action="/auth/logout">

                        <AntiforgeryToken />

                        <button type="submit"
                                class="nav-link border-0 bg-transparent w-100 text-start">
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>