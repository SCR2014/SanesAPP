@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">

            <AuthorizeView>
                <Authorized Context="authContext">

                    <span class="me-2">
                        @authContext.User.Identity?.Name
                    </span>

                    @if (authContext.User.IsInRole(
                        WebRoles.Administrator))
                    {
                        <span class="badge text-bg-primary">
                            Administrador
                        </span>
                    }
                    else if (authContext.User.IsInRole(
                        WebRoles.Collector))
                    {
                        <span class="badge text-bg-secondary">
                            Cobrador
                        </span>
                    }

                </Authorized>
            </AuthorizeView>

        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui"
     data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="."
       class="reload">
        Recargar
    </a>
    <span class="dismiss">
        🗙
    </span>
</div>