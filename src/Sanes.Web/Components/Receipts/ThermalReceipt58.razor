<div class="sanes-print-receipt">

    <div class="thermal-center thermal-title">
        @Receipt.TenantName
    </div>

    @if (!string.IsNullOrWhiteSpace(
        Receipt.TenantLegalName))
    {
        <div class="thermal-center">
            @Receipt.TenantLegalName
        </div>
    }

    <div class="thermal-center thermal-section-title">
        RECIBO DE PAGO
    </div>

    @if (Receipt.IsReversed)
    {
        <div class="thermal-center thermal-section-title">
            *** RECIBO ANULADO ***
        </div>
    }

    <div class="thermal-center thermal-receipt-number">
        @Receipt.ReceiptNumber
    </div>

    <div class="thermal-separator"></div>

    <div class="thermal-row">
        <span>Fecha:</span>
        <span>
            @(Receipt.PaymentDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
        </span>
    </div>

    <div class="thermal-block">
        <div>
            Cliente:
        </div>

        <strong>
            @Receipt.ClientName
        </strong>
    </div>

    <div class="thermal-block">
        <div>
            Tipo:
        </div>

        <strong>
            @PaymentTypeText(
                Receipt.PaymentType)
        </strong>
    </div>

    <div class="thermal-separator"></div>

    <div class="thermal-row thermal-total">
        <span>Monto recibido</span>

        <span>
            @Money(
                Receipt.AmountReceived)
        </span>
    </div>

    <div class="thermal-row">
        <span>Aplicado a mora</span>

        <span>
            @Money(
                Receipt.LateFeeAmountApplied)
        </span>
    </div>

    <div class="thermal-row">
        <span>Aplicado préstamo</span>

        <span>
            @Money(
                Receipt.LoanBalanceAmountApplied)
        </span>
    </div>

    <div class="thermal-separator"></div>

    <div class="thermal-row">
        <span>Saldo contractual</span>

        <span>
            @Money(
                Receipt.ContractualBalanceAfter)
        </span>
    </div>

    <div class="thermal-row">
        <span>Mora pendiente</span>

        <span>
            @Money(
                Receipt.LateFeeBalanceAfter)
        </span>
    </div>

    <div class="thermal-row thermal-total">
        <span>Total pendiente</span>

        <span>
            @Money(
                Receipt.TotalOutstandingAfter)
        </span>
    </div>

    <div class="thermal-separator"></div>

    <div class="thermal-block">
        <div>
            Cobrador:
        </div>

        <strong>
            @(Receipt.CollectedByName ??
              "No especificado")
        </strong>
    </div>

    @if (!string.IsNullOrWhiteSpace(
        Receipt.Notes))
    {
        <div class="thermal-block">
            <div>
                Notas:
            </div>

            <span>
                @Receipt.Notes
            </span>
        </div>
    }

    @if (Receipt.IsReversed)
    {
        <div class="thermal-separator"></div>

        <div class="thermal-center thermal-section-title">
            PAGO REVERSADO
        </div>

        <div class="thermal-block">
            <div>
                Fecha reverso:
            </div>

            <strong>
                @ReversalDate
            </strong>
        </div>

        <div class="thermal-block">
            <div>
                Reversado por:
            </div>

            <strong>
                @ReversalUser
            </strong>
        </div>

        <div class="thermal-block">
            <div>
                Motivo:
            </div>

            <span>
                @ReversalReason
            </span>
        </div>
    }

    <div class="thermal-separator"></div>

    <div class="thermal-center thermal-footer">
        @(Receipt.IsReversed
            ? "DOCUMENTO ANULADO"
            : "Gracias por su pago")
    </div>

    <div class="thermal-center thermal-small">
        @Receipt.ReceiptNumber
    </div>

</div>

@code {
    [Parameter]
    public PaymentReceiptResponse Receipt { get; set; } =
        default!;

    private string ReversalDate =>
        Receipt.ReversedAt.HasValue
            ? Receipt.ReversedAt.Value
                .ToLocalTime()
                .ToString(
                    "dd/MM/yyyy HH:mm")
            : "No especificada";

    private string ReversalUser =>
        !string.IsNullOrWhiteSpace(
            Receipt.ReversedByName)
            ? Receipt.ReversedByName
            : Receipt.ReversedByAppUserId
                ?.ToString()
              ?? "No especificado";

    private string ReversalReason =>
        string.IsNullOrWhiteSpace(
            Receipt.ReversalReason)
            ? "No especificado"
            : Receipt.ReversalReason;

    private string Money(
        decimal amount)
    {
        var currency =
            !string.IsNullOrWhiteSpace(
                Receipt.CurrencySymbol)
                ? Receipt.CurrencySymbol
                : Receipt.CurrencyCode;

        if (string.IsNullOrWhiteSpace(
                currency))
        {
            return amount.ToString(
                "N2");
        }

        return
            $"{currency} {amount:N2}";
    }

    private static string PaymentTypeText(
        PaymentType paymentType)
    {
        return paymentType switch
        {
            PaymentType.Regular =>
                "Pago regular",

            PaymentType.Partial =>
                "Pago parcial",

            PaymentType.FullSettlement =>
                "Pago total",

            _ =>
                paymentType.ToString()
        };
    }
}